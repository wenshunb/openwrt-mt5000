From 05dc1768cbe3221af8c448c783ddfc58f2b95564 Mon Sep 17 00:00:00 2001
Subject: [PATCH] sane-backends: depend on scanner-support for the group

Backport https://github.com/openwrt/packages/commit/05dc1768cbe3221af8c448c783ddfc58f2b95564
to keep the pinned packages feed compatible with the newer OpenWrt core.

diff --git a/utils/sane-backends/Makefile b/utils/sane-backends/Makefile
--- a/utils/sane-backends/Makefile
+++ b/utils/sane-backends/Makefile
@@ -11,6 +11,6 @@ include $(TOPDIR)/rules.mk
 PKG_NAME:=sane-backends
 PKG_VERSION:=1.4.0
-PKG_RELEASE:=1
+PKG_RELEASE:=2

 PKG_SOURCE:=$(PKG_NAME)-$(PKG_VERSION).tar.gz
 PKG_SOURCE_URL:=https://gitlab.com/-/project/429008/uploads/843c156420e211859e974f78f64c3ea3/
@@ -127,7 +127,7 @@ define Package/sane-daemon
 $(call Package/sane-backends/Default)
   SECTION:=utils
   CATEGORY:=Utilities
-  DEPENDS:=+libsane
+  DEPENDS:=scanner-support +libsane
   TITLE+= (network daemon)
-  USERID:=saned:scanner
+  USERID:=saned:scanner=47
 endef
